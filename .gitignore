/.quarto/
.Rproj.user

# macOS
.DS_Store

# Stale Quarto output dir (site now renders to documents/)
/_site/

# Secrets - never commit tokens. ZENODO_TOKEN belongs in your shell profile,
# outside this repository.
.env
.env.*
*token*
*secret*
.Renviron
# generated by scripts/build_handbook.py on every render
_handbook/
# generated by scripts/build_categories.py on every render
_includes/category-facets.html
# _includes/home-riv.md is also generated (scripts/build_report_meta.py) but is
# committed on purpose: Quarto resolves {{< include >}} before pre-render runs,
# so the file has to exist already. Each render refreshes it.

# Scratch folders (transfer files, one-off outputs). Never part of the site.
_to_delete/

# Python caches
__pycache__/
*.pyc

# LaTeX build logs left beside the PDF extension
acePDF.log

**/*.quarto_ipynb

# LaTeX build leftovers beside a report
reports/**/*.log
reports/**/*.aux
reports/**/index.tex
reports/**/index.html
